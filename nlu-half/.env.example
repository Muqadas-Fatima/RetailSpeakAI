# --- Database (Supabase Postgres with pgvector) — TDD §13.1 ---
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/retailspeak

# --- Session state (Upstash Redis) — TDD §2.1, §13.1 ---
REDIS_URL=rediss://default:password@your-upstash-endpoint:6379

# --- ASR (Groq Whisper primary, AWS Transcribe fallback) — TDD §2.2 ---
GROQ_API_KEY=your_groq_api_key
GROQ_WHISPER_MODEL=whisper-large-v3
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_REGION=me-south-1
ASR_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
ASR_CIRCUIT_BREAKER_TIMEOUT_SECONDS=2.5
ASR_CIRCUIT_BREAKER_OPEN_SECONDS=60

# --- LLM grounding (Qwen-2.5-7B/vLLM primary per TDD §2.5; Groq LLaMA-3.1 fallback) ---
# NOTE (placeholder, flagged): this environment cannot self-host a vLLM/Qwen-2.5-7B
# GPU deployment. LLM_PRIMARY_BASE_URL defaults to an OpenAI-compatible vLLM endpoint
# you control; point it at your own vLLM server serving Qwen-2.5-7B-Instruct in prod.
LLM_PRIMARY_BASE_URL=http://localhost:8001/v1
LLM_PRIMARY_MODEL=Qwen2.5-7B-Instruct
LLM_PRIMARY_API_KEY=not-needed-for-local-vllm
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=llama-3.1-8b-instant
LLM_FALLBACK_API_KEY=your_groq_api_key

# --- RAG embeddings (BGE-Small-EN-v1.5) — TDD §2.4 ---
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
RAG_SIMILARITY_FLOOR=0.72
RAG_AUTO_ACCEPT_THRESHOLD=0.85
RAG_TOP_K=3

# --- Auth (AWS Cognito, 4 roles) — TDD §14 ---
COGNITO_REGION=me-south-1
COGNITO_USER_POOL_ID=your_pool_id
COGNITO_APP_CLIENT_ID=your_client_id
COGNITO_JWKS_URL=https://cognito-idp.me-south-1.amazonaws.com/your_pool_id/.well-known/jwks.json

# --- Misc ---
ENVIRONMENT=dev
PAYMENT_ENV=sandbox
LOG_LEVEL=INFO
